{
  "name": "photo299",
  "productName": "Photo299",
  "version": "1.0.0",
  "description": "Photo299 - editor di immagini desktop leggero in stile Photoshop",
  "main": "main.js",
  "author": "MirkoVanzetto",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.photo299.app",
    "productName": "Photo299",
    "copyright": "Copyright © 2026 Photo299",
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": "p299",
        "name": "Progetto Photo299",
        "description": "Progetto Photo299"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Photo299",
      "artifactName": "Photo299-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Photo299-Portable-${version}.exe"
    }
  }
}
